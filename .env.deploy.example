# Identifiants FTP OVH pour `npm run deploy`.
# Copier ce fichier en .env.deploy (gitignored) et compléter.
# Infos dans l'espace client OVH → Hébergements → FTP-SSH.

FTP_HOST=ftp.cluster0XX.hosting.ovh.net
FTP_USER=qfjbfr
FTP_PASSWORD=
# Répertoire distant = racine web du domaine. Souvent "/www" ou "/".
FTP_REMOTE_DIR=/www
# Mettre à "true" si l'hébergement accepte le FTP explicite (FTPS). Sinon "false".
FTP_SECURE=false
