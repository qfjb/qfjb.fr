# QFJB — hébergement statique (Apache / OVH)
# Le site est entièrement prérendu : chaque route a son propre index.html.

# Force HTTPS + domaine canonique sans www (les deux certificats sont actifs).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.qfjb.fr  ->  qfjb.fr  (en https directement, un seul saut)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # http  ->  https  (OVH termine parfois le TLS en amont : on teste aussi
  # X-Forwarded-Proto pour éviter une boucle de redirection)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

# En-têtes de sécurité de base
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# Assets au nom hashé (immuables) : cache long
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|jpg|jpeg|png|gif|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Les pages HTML doivent toujours être revalidées
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
